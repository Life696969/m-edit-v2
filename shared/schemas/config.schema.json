{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "output_root",
    "source_hash_mode",
    "transcription",
    "workflow",
    "direction",
    "edit_rules",
    "depth",
    "assets",
    "render",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "mode": {
      "type": "string",
      "minLength": 1
    },
    "output_root": {
      "type": "string",
      "minLength": 1
    },
    "source_hash_mode": {
      "enum": [
        "full",
        "stat"
      ]
    },
    "transcription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "language",
        "model",
        "model_path",
        "existing_caption_globs",
        "word_timestamps"
      ],
      "properties": {
        "provider": {
          "enum": [
            "auto",
            "existing",
            "openai-whisper",
            "faster-whisper",
            "whisper-cpp",
            "host"
          ]
        },
        "language": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "model_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "existing_caption_globs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "word_timestamps": {
          "type": "boolean"
        },
        "allow_network": {
          "type": "boolean"
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preview_approval_required",
        "merge_requires_explicit_request"
      ],
      "properties": {
        "preview_approval_required": {
          "const": true
        },
        "merge_requires_explicit_request": {
          "const": true
        }
      }
    },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_questions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "min_questions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "edit_rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "camera_pulse_seconds": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 3
        },
        "camera_scale_min": {
          "type": "number",
          "minimum": 1,
          "maximum": 1.3
        },
        "camera_scale_max": {
          "type": "number",
          "minimum": 1,
          "maximum": 1.3
        },
        "camera_drift_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.05
        },
        "camera_min_move": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.05
        },
        "edge_margin_px": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "cutaway_share_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.8
        },
        "cutaway_max_seconds": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 30
        },
        "max_caption_words": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "max_caption_hold_seconds": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 10
        },
        "max_anchor_hits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "background": {
          "enum": [
            "preserve",
            "allow-replace"
          ]
        },
        "people_require_spoken_name": {
          "type": "boolean"
        },
        "caption_mouth_gap_px": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "card_eye_clearance_px": {
          "type": "number",
          "minimum": 0,
          "maximum": 800
        }
      }
    },
    "depth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matte_provider": {
          "enum": [
            "none",
            "rvm-onnx",
            "precomputed"
          ]
        },
        "model_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_network",
        "require_source_ledger"
      ],
      "properties": {
        "allow_network": {
          "type": "boolean"
        },
        "allow_free_licensed_downloads": {
          "type": "boolean"
        },
        "require_source_ledger": {
          "type": "boolean"
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspect_ratio",
        "width",
        "height",
        "fps",
        "codec",
        "container",
        "require_audio",
        "preview_scale",
        "preview_crf",
        "final_crf",
        "fidelity_min_ssim"
      ],
      "properties": {
        "aspect_ratio": {
          "enum": [
            "auto",
            "vertical",
            "horizontal",
            "square",
            "custom"
          ]
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "fps": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "codec": {
          "type": "string"
        },
        "container": {
          "type": "string"
        },
        "require_audio": {
          "enum": [
            "auto",
            true,
            false
          ]
        },
        "preview_scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "preview_crf": {
          "type": "integer",
          "minimum": 0,
          "maximum": 51
        },
        "final_crf": {
          "type": "integer",
          "minimum": 0,
          "maximum": 51
        },
        "fidelity_min_ssim": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "renderer_timeout_ms": {
          "type": "integer",
          "minimum": 30000,
          "maximum": 3600000
        },
        "retry_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ffmpeg_timeout_seconds",
        "full_decode",
        "generate_contact_sheet",
        "compare_final_to_preview"
      ],
      "properties": {
        "ffmpeg_timeout_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 7200
        },
        "full_decode": {
          "type": "boolean"
        },
        "generate_contact_sheet": {
          "type": "boolean"
        },
        "compare_final_to_preview": {
          "type": "boolean"
        }
      }
    }
  }
}
